{
  "name": "@umage.ai/redline-voice",
  "version": "0.1.0",
  "description": "Voice notes and recorded review sessions for Redline's dev server: talk instead of typing, point while you talk. Transcribed by the browser, your own Whisper server, a local tool or any OpenAI-compatible API. Local dev only.",
  "type": "module",
  "license": "MIT",
  "author": "umage.ai <morten@umage.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umage-ai/redline.git",
    "directory": "voice"
  },
  "homepage": "https://github.com/umage-ai/redline/tree/main/voice#readme",
  "bugs": "https://github.com/umage-ai/redline/issues",
  "keywords": [
    "redline",
    "voice",
    "speech-to-text",
    "whisper",
    "screen-recording",
    "design-review",
    "ai-agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "peerDependencies": {
    "@umage.ai/redline": ">=0.11.0"
  },
  "peerDependenciesMeta": {
    "@umage.ai/redline": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
