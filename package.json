{
  "name": "@umage-ai/redline",
  "version": "0.1.0",
  "description": "Dev-only UI feedback overlay: pin comments, sketches and text changes on any web UI, saved as markdown an AI agent can work through.",
  "type": "module",
  "license": "MIT",
  "author": "UMAGE AI <morten@umage.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umage-ai/redline.git"
  },
  "homepage": "https://github.com/umage-ai/redline#readme",
  "bugs": "https://github.com/umage-ai/redline/issues",
  "keywords": [
    "vite-plugin",
    "astro-integration",
    "sveltekit",
    "react",
    "feedback",
    "annotation",
    "design-review",
    "overlay",
    "ai-agent",
    "claude"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "redline": "./dist/cli.js"
  },
  "exports": {
    "./vite": {
      "types": "./dist/types/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./astro": {
      "types": "./dist/types/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./server": {
      "types": "./dist/types/server/index.d.ts",
      "default": "./dist/server.js"
    },
    "./client.js": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "vite": ">=7"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "skill"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run check:docs",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "magic-string": "^1.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-react": "^6.1.2",
    "astro": "^6.4.8",
    "esbuild": "^0.28.2",
    "modern-screenshot": "^4.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svelte": "^5.57.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
