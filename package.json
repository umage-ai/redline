{
  "name": "@umage.ai/redline",
  "version": "0.4.0",
  "description": "Dev-only UI feedback overlay: pin comments, sketches and text changes on any web UI, saved as markdown an AI agent can work through.",
  "type": "module",
  "license": "MIT",
  "author": "umage.ai <morten@umage.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umage-ai/redline.git"
  },
  "homepage": "https://github.com/umage-ai/redline#readme",
  "bugs": "https://github.com/umage-ai/redline/issues",
  "keywords": [
    "vite-plugin",
    "astro-integration",
    "sveltekit",
    "react",
    "vue",
    "angular",
    "solid-js",
    "preact",
    "feedback",
    "annotation",
    "design-review",
    "overlay",
    "ai-agent",
    "claude",
    "codex",
    "cursor",
    "copilot",
    "gemini",
    "agents-md",
    "agent-skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "builders": "dist/builders.json",
  "bin": {
    "redline": "dist/cli.js"
  },
  "exports": {
    "./vite": {
      "types": "./dist/types/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./astro": {
      "types": "./dist/types/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./server": {
      "types": "./dist/types/server/index.d.ts",
      "default": "./dist/server.js"
    },
    "./angular": {
      "types": "./dist/types/angular.d.ts",
      "default": "./dist/angular.js"
    },
    "./client.js": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "vite": ">=7"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "skill"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run check:docs",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "test:package": "node scripts/test-package.mjs",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run check && npm run test:package",
    "smoke": "node scripts/smoke.mjs",
    "demo": "npm run build && vite --config examples/demo/vite.config.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "promo": "npm run build && node promo/record.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "magic-string": "^1.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "astro": "^6.4.8",
    "esbuild": "^0.28.2",
    "modern-screenshot": "^4.7.0",
    "preact": "^11.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "^1.9.17",
    "svelte": "^5.57.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vue": "^3.5.44"
  }
}
