<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Umage.Redline</RootNamespace>
    <PackageId>Umage.Redline.AspNetCore</PackageId>
    <Description>Redline for ASP.NET Core (Razor Pages, MVC, Blazor): a review overlay where a reviewer pins comments, text changes and sketches on the running app; notes are saved as markdown (or to a database online) for an AI agent to apply.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Source stamps (data-redline-src on Razor markup, Debug builds only) come with the build package. -->
  <ItemGroup>
    <ProjectReference Include="..\Umage.Redline.Build\Umage.Redline.Build.csproj" PrivateAssets="none" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umage.Redline.Tests" />
    <InternalsVisibleTo Include="Umage.Redline.Optimizely" />
  </ItemGroup>

  <!-- The browser overlay is the same bundle the npm package ships (dist/client.js): embedded, never forked. -->
  <PropertyGroup>
    <RedlineClientJs>$(RedlineRepoRoot)\dist\client.js</RedlineClientJs>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(RedlineClientJs)" LogicalName="Umage.Redline.client.js" Link="client.js" />
    <EmbeddedResource Include="Assets/tokens.js" LogicalName="Umage.Redline.tokens.js" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
  <Target Name="RedlineBuildClient" BeforeTargets="BeforeBuild;PrepareForBuild" Condition="!Exists('$(RedlineClientJs)')">
    <Message Importance="high" Text="Redline: $(RedlineClientJs) is missing; running npm run build in $(RedlineRepoRoot)" />
    <Exec Command="npm ci" WorkingDirectory="$(RedlineRepoRoot)" Condition="!Exists('$(RedlineRepoRoot)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(RedlineRepoRoot)" />
    <Error Condition="!Exists('$(RedlineClientJs)')" Text="Redline: could not build $(RedlineClientJs). Run npm ci and npm run build in the repo root." />
  </Target>

</Project>
