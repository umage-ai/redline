<Project Sdk="Microsoft.NET.Sdk">

  <!-- MSBuild task + targets only: no library for consumers. netstandard2.0 loads in both dotnet build and Visual Studio's MSBuild. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageId>Umage.Redline.Build</PackageId>
    <Description>Build-time part of Redline for Razor and Blazor: in Debug builds, stamps data-redline-src="file:line:col" on HTML elements of .cshtml/.razor files so review notes name the source line. Comes with Umage.Redline.AspNetCore; reference it directly in a Blazor WebAssembly client project.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umage.Redline.Tests" />
    <None Include="build\*.targets" Pack="true" PackagePath="build\" />
    <None Include="buildTransitive\*.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="$(OutputPath)$(TargetFramework)\Umage.Redline.Build.dll" Pack="true" PackagePath="tasks\netstandard2.0\" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
