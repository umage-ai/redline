<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>UmageAI.Redline</RootNamespace>
    <PackageId>UmageAI.Redline.AspNetCore</PackageId>
    <Description>Redline for ASP.NET Core (Razor Pages, MVC, Blazor): a review overlay where a reviewer pins comments, text changes and sketches on the running app; notes are saved as markdown (or to a database online) for an AI agent to apply.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NU5100: the MSBuild task DLL goes to tasks/ on purpose (nothing to reference). -->
    <NoWarn>$(NoWarn);CS1591;NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Source stamps (data-redline-src on Razor markup, Debug builds only): this package carries the
    same targets and task as UmageAI.Redline.Build (buildTransitive, so they reach the site through
    UmageAI.Redline.Optimizely too). The project reference only orders the build.
  -->
  <PropertyGroup>
    <RedlineTaskDll>$(MSBuildThisFileDirectory)..\UmageAI.Redline.Build\bin\$(Configuration)\netstandard2.0\UmageAI.Redline.Build.dll</RedlineTaskDll>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UmageAI.Redline.Build\UmageAI.Redline.Build.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\UmageAI.Redline.Build\buildTransitive\UmageAI.Redline.Build.targets" Pack="true" PackagePath="buildTransitive\UmageAI.Redline.AspNetCore.targets" Link="build\UmageAI.Redline.Build.targets" />
    <None Include="..\UmageAI.Redline.Build\buildTransitive\UmageAI.Redline.Build.targets" Pack="true" PackagePath="build\UmageAI.Redline.AspNetCore.targets" Visible="false" />
    <None Include="$(RedlineTaskDll)" Pack="true" PackagePath="tasks\netstandard2.0\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UmageAI.Redline.Tests" />
    <InternalsVisibleTo Include="UmageAI.Redline.Optimizely" />
  </ItemGroup>

  <!-- The browser overlay is the same bundle the npm package ships (dist/client.js): embedded, never forked. -->
  <PropertyGroup>
    <RedlineClientJs>$(RedlineRepoRoot)\dist\client.js</RedlineClientJs>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(RedlineClientJs)" LogicalName="UmageAI.Redline.client.js" Link="client.js" />
    <EmbeddedResource Include="Assets/tokens.js" LogicalName="UmageAI.Redline.tokens.js" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
  <Target Name="RedlineBuildClient" BeforeTargets="BeforeBuild;PrepareForBuild" Condition="!Exists('$(RedlineClientJs)')">
    <Message Importance="high" Text="Redline: $(RedlineClientJs) is missing; running npm run build in $(RedlineRepoRoot)" />
    <Exec Command="npm ci" WorkingDirectory="$(RedlineRepoRoot)" Condition="!Exists('$(RedlineRepoRoot)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(RedlineRepoRoot)" />
    <Error Condition="!Exists('$(RedlineClientJs)')" Text="Redline: could not build $(RedlineClientJs). Run npm ci and npm run build in the repo root." />
  </Target>

</Project>
