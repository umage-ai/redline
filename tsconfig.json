{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "@umage.ai/redline/server": ["./src/server/index.ts"]
    }
  },
  "include": [
    "src",
    "hub/src",
    "examples/review-frontend",
    "test/unit",
    "test/e2e",
    "test/package",
    "playwright.package.config.ts",
    "playwright.config.ts"
  ]
}
